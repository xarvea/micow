{
  "name": "@micow/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run src/store.integration.test.ts",
    "reconcile": "tsx src/reconcile.ts",
    "test:process": "vitest run src/worker.process.integration.test.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "pg": "8.16.3",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
